rules_version = '2';

// Mirrors firestore.rules: every file lives under users/{uid}/... and only
// that uid may read or write it. Writes are additionally capped at 20MB —
// generous for a receipt photo or a bank statement PDF, tight enough to
// block someone trying to use the app's storage bucket for arbitrary large
// uploads. See docs/FIREBASE.md "Storage" for the path layout.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024;
    }

    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
