# Copy this file to .env and fill in your Firebase project's values
# (Firebase Console > Project settings > General > Your apps > SDK setup
# and configuration).
#
# These are CLIENT config values, not secrets — the API key below only
# identifies which Firebase project to talk to; it grants no access by
# itself. Access control is enforced by firestore.rules and storage.rules,
# not by keeping this file hidden. Still:
#   - never commit a real .env (it's gitignored — keep it that way)
#   - never put an Admin SDK service-account credential or any other
#     server-only secret behind an EXPO_PUBLIC_ prefix — those are compiled
#     into the client bundle in plain text for anyone to read
# See docs/FIREBASE.md for the full explanation.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional — only present if Analytics is enabled on your Firebase project.
# Not read anywhere in this app yet (no Firebase Analytics integration),
# safe to leave blank or omit entirely.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
