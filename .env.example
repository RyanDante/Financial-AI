# Copy this file to .env and fill in your Firebase project's values
# (Firebase Console > Project settings > General > Your apps > SDK setup
# and configuration).
#
# These are CLIENT config values, not secrets — the API key below only
# identifies which Firebase project to talk to; it grants no access by
# itself. Access control is enforced by firestore.rules and storage.rules,
# not by keeping this file hidden. Still:
#   - never commit a real .env (it's gitignored — keep it that way)
#   - never put an Admin SDK service-account credential or any other
#     server-only secret behind an EXPO_PUBLIC_ prefix — those are compiled
#     into the client bundle in plain text for anyone to read
# See docs/FIREBASE.md for the full explanation.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional — only present if Analytics is enabled on your Firebase project.
# Not read anywhere in this app yet (no Firebase Analytics integration),
# safe to leave blank or omit entirely.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── AI copilot (optional) ────────────────────────────────────────────────
# DEVELOPMENT ONLY. Unlike the Firebase values above, an AI API key IS a
# secret, and every EXPO_PUBLIC_* value is compiled into the app bundle,
# where anyone holding the app file can read it. Use this to test on your
# own phone; never share or publish a build made with a key here. A real
# release must call the model through a server that holds the key.
#
# Leave EXPO_PUBLIC_AI_PROVIDER empty (or "mock") for the offline copilot,
# which answers from built-in rules and needs no key.
#
#   anthropic : Claude. EXPO_PUBLIC_AI_MODEL is optional (default claude-opus-5-5).
#   openai    : OpenAI, or any OpenAI-compatible host via EXPO_PUBLIC_AI_BASE_URL
#               (e.g. https://api.groq.com/openai/v1). EXPO_PUBLIC_AI_MODEL is required.
#   gemini    : Google Gemini. EXPO_PUBLIC_AI_MODEL is required.
#
# Restart with `npx expo start -c` after changing these.
EXPO_PUBLIC_AI_PROVIDER=
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_MODEL=
EXPO_PUBLIC_AI_BASE_URL=
